PORT=4000

# Origen permitido para CORS (la URL donde corre el frontend en dev)
FRONTEND_ORIGIN=http://localhost:5183

# API externa centralizadora
EXTERNAL_API_BASE_URL=https://api-centralizador.apiworking.pe/api

# Cookie de sesion donde se guarda el token recibido de la API externa
SESSION_COOKIE_NAME=pv_token
# Cookie que guarda el nombre de usuario (para auditoria en notas/tareas/config)
SESSION_USER_COOKIE_NAME=pv_user
# En produccion (https) debe ser "true"
COOKIE_SECURE=false

# Paginacion al traer TODAS las ordenes de servicio desde APIWorking (dataset
# compartido, sincronizado 1 vez al dia — ver services/postventa/scheduler.ts)
ORDENES_SYNC_PAGE_SIZE=500
ORDENES_SYNC_MAX_PAGES=50
# Cache de postventa_config
CONFIG_CACHE_TTL_MS=60000

# Token de respaldo (JWT). Es la credencial del sync diario compartido del
# dataset Post Venta, ademas de servir como fallback cuando el rol del
# usuario logueado no tiene permiso sobre un recurso puntual de APIWorking
# (codResponse "403"). Expira periodicamente y hay que reemplazarlo a mano —
# no poner el valor real aca, solo en .env local.
FALLBACK_API_TOKEN=

# MySQL (no se usa todavia en esta etapa, se deja preparado)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=post_venta
